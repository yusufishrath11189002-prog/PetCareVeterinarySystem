<jasperReport name="PetCareReport" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bc6f4edf-3cd6-4de2-a8c1-cc93b372e7bc">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="PetCareDataBase.jrdax"/>
	<query language="SQL"><![CDATA[SELECT
    c.customer_id,
    c.customer_name,
    c.phone,
    p.pet_name,
    p.species,
    p.breed,
    a.appointment_date,
    a.appointment_time,
    a.reason,
    a.status
FROM customers c
JOIN pets p ON c.customer_id = p.customer_id
JOIN appointments a ON p.pet_id = a.pet_id]]></query>
